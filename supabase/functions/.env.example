# Copy to .env for local Edge Function testing, or set these in
# Supabase Dashboard → Edge Functions → Secrets.
#
# WECHAT_APP_ID and WECHAT_APP_SECRET come from the WeChat Open Platform
# website application. Never put WECHAT_APP_SECRET in frontend files.
WECHAT_APP_ID=wx_your_website_app_id
WECHAT_APP_SECRET=your_website_app_secret
WECHAT_CALLBACK_URL=https://YOUR_PROJECT_REF.supabase.co/functions/v1/wechat-auth?action=callback
ALLOWED_ORIGINS=https://xuanyuan-12.github.io,http://127.0.0.1:8765
